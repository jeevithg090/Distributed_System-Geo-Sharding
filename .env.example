# Copy to .env and change every secret before running anything outside your laptop.
#   cp .env.example .env

# --- PostgreSQL shards (all three shards share credentials) -------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sharddb

# Shard addresses as seen by the process reading this file.
# Host-side defaults match the ports Docker Compose publishes; inside Compose
# the API container overrides these with the service names.
SHARD_US_HOST=localhost
SHARD_US_PORT=5433
SHARD_EU_HOST=localhost
SHARD_EU_PORT=5434
SHARD_ASIA_HOST=localhost
SHARD_ASIA_PORT=5435
DB_CONNECT_TIMEOUT=3

# --- Redis ----------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- API behaviour ---------------------------------------------------------------
# When set, mutating admin endpoints (cache flush, RAG reindex, deadlock
# simulation, consumer scaling) require the header "X-API-Key: <value>".
ADMIN_API_KEY=
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RECOVERY_TIMEOUT=15
CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO

# --- RAG ----------------------------------------------------------------------------
# auto  = sentence-transformers if installed, otherwise hash embeddings
# model = require sentence-transformers;  hash = never load a model
RAG_EMBEDDING_BACKEND=auto
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_INDEX_PATH=data/rag_index.json

# --- Monitoring (Docker Compose only) -----------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too
